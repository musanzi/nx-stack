  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Pings the database and checks disk storage.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy\n\nThe Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "info": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "info": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "error": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "up",
                              "degraded",
                              "down"
                            ]
                          },
                          "responseTime": {
                            "type": "number",
                            "description": "Time the health indicator took to respond, in ms"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check service health",
        "tags": [
          "health"
        ]
      }
    },
