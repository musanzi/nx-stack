{
  "name": "api-contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/api-contracts/src",
  "tags": ["scope:shared", "type:contracts"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node tools/generate-api.mjs"
      },
      "dependsOn": [
        {
          "projects": ["api"],
          "target": "openapi"
        }
      ],
      "outputs": ["{projectRoot}/src"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/api-contracts/tsconfig.lib.json --noEmit"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/api-contracts/tsconfig.lib.json --noEmit"
      }
    }
  },
  "implicitDependencies": ["api"]
}
