{
  "name": "nx-stack",
  "version": "0.0.0",
  "description": "Angular web and NestJS API Nx workspace",
  "author": {
    "name": "Wilfried Musanzi",
    "url": "https://musanzi.me"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p api web --parallel=2",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "build": "nx run-many -t build -p api web",
    "lint": "nx run-many -t lint -p api web api-contracts",
    "generate:api": "nx run api-contracts:generate",
    "sync:api": "pnpm generate:api && nx build web",
    "start:api": "nx run api:start",
    "start:web": "nx run web:start",
    "db:migrate": "nx run api:db-migrate",
    "db:up": "nx run api:db-up",
    "db:down": "nx run api:db-down",
    "db:seed": "nx run api:db-seed",
    "prepare": "husky"
  },
