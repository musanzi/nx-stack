{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "cacheDirectory": ".nx/cache",
  "workspaceDataDirectory": ".nx/workspace-data",
  "neverConnectToCloud": true,
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.node-version"
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/.env",
      "!{projectRoot}/.env.*",
      "!{projectRoot}/uploads/**/*",
      "!{projectRoot}/node_modules/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/README.md",
      "!{projectRoot}/AGENTS.md"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "serve": {
      "cache": false
    },
    "start": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  },
  "generators": {
    "@nx/angular:component": {
      "skipTests": true
    },
    "@nx/angular:library": {
      "unitTestRunner": "none"
    },
    "@nx/angular:application": {
      "unitTestRunner": "none",
      "e2eTestRunner": "none"
    }
  }
}
